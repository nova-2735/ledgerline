# Copy to .env and fill in. Placeholders only; never commit real values.

# development | test | production
APP_ENV=development
# YYYY-MM-DD; pins "today" for the demo world (leave empty for the real date)
APP_TODAY=
DATA_DIR=./data
# Defaults to sqlite:///{DATA_DIR}/ledgerline.db; a Postgres URL also works
DATABASE_URL=

# gemini | fake | openai_compat
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_MODEL_LIGHT=gemini-3.5-flash-lite
GEMINI_API_KEY=your-gemini-api-key
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
LLM_TIMEOUT_S=60
# Thinking cap for invoice transcription: off | low | medium | high | <token budget>
LLM_THINKING=low
LLM_CACHE=1
LLM_EXPLAIN=1
LLM_PRICE_IN_PER_M=
LLM_PRICE_OUT_PER_M=
MAX_LIVE_LLM_CALLS_PER_HOUR=120
# Per client address: share of live readings per hour, and runs started per minute (0 = off)
MAX_LIVE_LLM_CALLS_PER_CLIENT_PER_HOUR=30
RATE_LIMIT_RUNS_PER_MINUTE=10
RATE_LIMIT_BURST=10
ALLOW_FAKE_LLM=0

# auto | 0 | 1
OCR_ENABLED=auto
POLICY_PATH=backend/policy/default_policy.yaml
MAX_UPLOAD_MB=10
MAX_PAGES=10
WORKERS=2
CORS_ORIGINS=http://localhost:5173
DEMO_ACCESS_CODE=
INVOICE_FONT_PATH=

# Email intake (optional)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=
IMAP_POLL_SECONDS=
IMAP_ALLOWED_SENDERS=

PORT=8000

# Frontend (Vite)
VITE_USE_MOCKS=0
VITE_API_BASE=/api
